# Shared site configuration imported by Caddyfile.lan and Caddyfile.proxy.
# The standalone GitHub Actions workflow removes the MDB58 handles before packaging.
root * /srv/wrapped365
encode zstd gzip
header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
}

# Same-origin routes for the full edition only (removed from standalone image).
handle /mdb58/admin* {
    reverse_proxy mdb58-api:8080
}
handle /mdb58/api/* {
    reverse_proxy mdb58-api:8080
}

@html path / /index.html
header @html Cache-Control "no-cache"
file_server
