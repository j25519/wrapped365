# Never commit .env or secrets.

# Wrapped 365 deployment settings. Copy to .env; do not commit secrets.
# Only two network modes are supported: lan or proxy.
WRAPPED365_NETWORK_MODE=lan

# The exact URL used in the BROWSER (no trailing slash or path). Compose
# automatically passes this to MDB58_ALLOWED_ORIGIN; do not set that separately.
# LAN:   https://192.168.1.219:6967
# Proxy: https://beta.example.com
WRAPPED365_PUBLIC_ORIGIN=https://192.168.1.219:6967

# LAN-only TLS hostname/IP settings (ignored by proxy listener).
WRAPPED365_LAN_IP=192.168.1.219
WRAPPED365_LAN_HOST=asus-box.local

# LAN: 0.0.0.0 allows LAN clients to connect on :6967 (restrict at firewall).
# VPS: 127.0.0.1 prevents direct access to the inner server from the internet.
# If outer Caddy runs IN A DIFFERENT CONTAINER, use an internal Docker network
# rather than localhost: the reverse proxy will not see the host loopback.
WRAPPED365_HOST_BIND=0.0.0.0

# The frontend image controls edition. Standalone is the default; MDB58 is
# enabled separately using the mdb58 Compose profile and matching full image.
WRAPPED365_IMAGE_TAG=beta-standalone
MDB58_IMAGE_TAG=beta-full

# Generate TWO DIFFERENT values with: openssl rand -hex 32
# Hex avoids accidental URL encoding errors in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MDB58_INVITE_PEPPER=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

# ClamAV container is provisioned by this Compose file.
MDB58_CLAMAV_REQUIRED=false

# Key to securely setup admin panel password
MDB58_ADMIN_SETUP_TOKEN=YOUR_GENERATED_KEY
